# Local defaults match docker-compose.yml. On Railway these come from service variables/references.

# --- Database (Postgres + PostgREST) ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
POSTGREST_URL=http://127.0.0.1:54321
PGRST_JWT_SECRET=local-dev-jwt-secret-at-least-32-characters
AUTHENTICATOR_PASSWORD=local-authenticator-password

# --- Sessions (long random string) ---
SESSION_SECRET=change-me-to-64-random-hex-chars

# --- First owner (created by the migration only if no owner exists yet) ---
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please

# --- Product image storage (S3-compatible) ---
S3_ENDPOINT=http://127.0.0.1:54323
S3_BUCKET=product-images
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pakz-local
S3_SECRET_ACCESS_KEY=pakz-local-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=GBP
NEXT_PUBLIC_LOCALE=en-GB
# Zone for displaying/entering date-times; keep it the same as Settings → Timezone
NEXT_PUBLIC_TIMEZONE=Europe/London
CRON_SECRET=change-me

# --- Optional integrations ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM="PAKZ <orders@example.com>"
ANTHROPIC_API_KEY=

# --- Storefront ---
NEXT_PUBLIC_STORE_NAME=PAKZ
# ISO country codes Stripe Checkout ships to
SHIP_COUNTRIES=GB
