# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=GBP
NEXT_PUBLIC_LOCALE=en-GB
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Stripe (refunds, checkout webhook) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email via Resend (shipping emails, reports, alerts) ---
RESEND_API_KEY=
EMAIL_FROM="PAKZ <orders@example.com>"

# --- Optional: weekly AI Buying Brief (Claude). Only aggregated metrics are sent, never customer data. ---
ANTHROPIC_API_KEY=
